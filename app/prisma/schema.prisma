// Prisma のスキーマファイル
// テーブルを変更したら `docker compose exec app npx prisma migrate dev --name <変更内容>` を実行する
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// メモ（仕様書「8. API設計」のメモオブジェクト）
// 設計の理由は docs/database.md を参照
// CHECK 制約は Prisma のスキーマに書けないので、マイグレーションの SQL に直接書いている
model Memo {
  id        Int      @id @default(autoincrement())
  // 100文字以内（N-02）
  title     String   @db.VarChar(100)
  // 10,000文字以内（N-02）
  content   String   @db.Text
  // 論理削除フラグ（N-01）
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 一覧取得（未削除を更新日時の降順。F-01）用
  @@index([isDeleted, updatedAt], map: "idx_memos_is_deleted_updated_at")
  @@map("memos")
}
